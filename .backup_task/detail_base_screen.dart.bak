import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:base_coc/fitur/detail_base/provider/base_serupa_provider.dart';
import 'package:base_coc/fitur/detail_base/service/clipboard_service.dart';
import 'package:base_coc/fitur/detail_base/service/share_base_service.dart';
import 'package:base_coc/fitur/detail_base/widget/base_serupa_view.dart';
import 'package:base_coc/fitur/detail_base/widget/konfirmasi_salin.dart';
import 'package:base_coc/fitur/detail_base/widget/panduan_base_view.dart';
import 'package:base_coc/fitur/galeri_base/model/base_layout.dart';
import 'package:base_coc/fitur/galeri_base/provider/tautan_status_provider.dart';

/// Layar detail base dengan preview gambar, pinch-to-zoom, tombol "Copy Base" menetap di bawah,
/// dan section "Base Serupa" (bila ada kandidat dari katalog lokal).
class DetailBaseScreen extends ConsumerStatefulWidget {
  const DetailBaseScreen({
    super.key,
    required this.base,
    this.clipboardService = const ClipboardService(),
  });

  final BaseLayout base;
  final ClipboardService clipboardService;

  @override
  ConsumerState<DetailBaseScreen> createState() => _DetailBaseScreenState();
}

class _DetailBaseScreenState extends ConsumerState<DetailBaseScreen> {
  final TransformationController _transformController =
      TransformationController();

  @override
  void dispose() {
    _transformController.dispose();
    super.dispose();
  }

  void _resetZoom() {
    _transformController.value = Matrix4.identity();
  }

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    final previewPath = widget.base.previewImagePath;
    final panduan = widget.base.panduan;
    final kandidatSerupa = ref
        .watch(baseSerupaProvider(widget.base))
        .asData
        ?.value;
    final antreanAsync = ref.watch(antreanTautanProvider);
    final perluDitinjau = antreanAsync.maybeWhen(
      data: (items) => items.any((t) => t.base.id == widget.base.id),
      orElse: () => false,
    );
    if (antreanAsync.hasError) {
      debugPrint(
        'DetailBaseScreen: gagal memuat antrean tautan: ${antreanAsync.error}',
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: Text(widget.base.id),
        actions: [
          IconButton(
            tooltip: 'Bagikan',
            onPressed: _bagikanBase,
            icon: const Icon(Icons.share),
          ),
          IconButton(
            tooltip: 'Reset zoom',
            onPressed: _resetZoom,
            icon: const Icon(Icons.zoom_out_map),
          ),
        ],
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              widget.base.labelTownHall,
              style: Theme.of(context).textTheme.headlineSmall,
            ),
            const SizedBox(height: 8),
            Text(
              _labelTipe(widget.base.tipe),
              style: Theme.of(context).textTheme.titleMedium
                  ?.copyWith(color: colorScheme.primary),
            ),
            const SizedBox(height: 16),
            if (panduan != null && panduan.hasIsi) ...[
              PanduanBaseView(panduan: panduan),
              const SizedBox(height: 16),
            ],
            SizedBox(
              height: 300,
              width: double.infinity,
              child: Center(
                child: InteractiveViewer(
                  transformationController: _transformController,
                  minScale: 1.0,
                  maxScale: 4.0,
                  child: previewPath.isNotEmpty
                      ? Image.asset(
                          previewPath,
                          fit: BoxFit.contain,
                          errorBuilder: (context, error, stackTrace) =>
                              const _PreviewErrorFallback(),
                        )
                      : const _PreviewErrorFallback(),
                ),
              ),
            ),
            const SizedBox(height: 16),
            SelectableText(
              widget.base.baseLink,
              style: Theme.of(context).textTheme.bodyMedium,
            ),
            const SizedBox(height: 8),
            Row(
              children: [
                if (perluDitinjau) ...[
                  const _BadgeTautanPerluDitinjau(),
                  const SizedBox(width: 8),
                ],
                TextButton.icon(
                  onPressed: _laporkanTautan,
                  icon: const Icon(Icons.report_problem_outlined, size: 18),
                  label: const Text('Laporkan tautan rusak'),
                ),
              ],
            ),
            if (kandidatSerupa != null && kandidatSerupa.isNotEmpty) ...[
              const SizedBox(height: 16),
              BaseSerupaView(
                kandidat: kandidatSerupa,
                onTap: (kandidat) {
                  Navigator.of(context).push(
                    MaterialPageRoute<void>(
                      builder: (_) => DetailBaseScreen(base: kandidat),
                    ),
                  );
                },
              ),
            ],
          ],
        ),
      ),
      bottomNavigationBar: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: FilledButton.icon(
            onPressed: () => _salinBase(context),
            icon: const Icon(Icons.copy),
            label: const Text('Copy Base'),
          ),
        ),
      ),
    );
  }

  void _laporkanTautan() {
    unawaited(
      ref
          .read(tautanStatusProvider.notifier)
          .lapor(widget.base.id)
          .then((_) {
            if (!mounted) {
              return;
            }
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Terima kasih, laporan tersimpan.')),
            );
          })
          .catchError((Object e, StackTrace s) {
            debugPrint(
              'DetailBaseScreen: gagal melaporkan tautan ${widget.base.id}: $e $s',
            );
            if (!mounted) {
              return;
            }
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(
                content: Text('Gagal menyimpan laporan. Coba lagi nanti.'),
              ),
            );
          }),
    );
  }

  void _bagikanBase() {
    unawaited(
      const ShareBaseService().bagikanBase(widget.base).catchError((
        Object e,
        StackTrace s,
      ) {
        debugPrint(
          'DetailBaseScreen: gagal membagikan base ${widget.base.id}: $e $s',
        );
      }),
    );
  }

  Future<void> _salinBase(BuildContext context) async {
    final hasil = await widget.clipboardService.salinBase(
      context,
      widget.base.baseLink,
    );
    if (!context.mounted) {
      return;
    }
    tampilkanKonfirmasiSalin(
      context,
      hasil,
      onBukaGame: hasil.sukses
          ? () {
              widget.clipboardService.bukaGame(widget.base.baseLink).then((
                dibuka,
              ) {
                if (!dibuka && context.mounted) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text(
                        'Clash of Clans tidak terpasang. Tempel tautan secara manual.',
                      ),
                    ),
                  );
                }
              });
            }
          : null,
    );
  }

  String _labelTipe(TipeBase tipe) {
    switch (tipe) {
      case TipeBase.war:
        return 'War';
      case TipeBase.farming:
        return 'Farming';
      case TipeBase.trophy:
        return 'Trophy';
      case TipeBase.hybrid:
        return 'Hybrid';
      case TipeBase.cwl:
        return 'CWL';
      case TipeBase.ring:
        return 'Ring';
      case TipeBase.box:
        return 'Box';
      case TipeBase.island:
        return 'Island';
    }
  }
}

/// Badge kecil "Tautan perlu ditinjau" di dekat `SelectableText(baseLink)`.
class _BadgeTautanPerluDitinjau extends StatelessWidget {
  const _BadgeTautanPerluDitinjau();

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
      decoration: BoxDecoration(
        color: colorScheme.errorContainer,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(
            Icons.warning_amber_rounded,
            size: 14,
            color: colorScheme.onErrorContainer,
          ),
          const SizedBox(width: 4),
          Text(
            'Tautan perlu ditinjau',
            style: Theme.of(context).textTheme.labelSmall?.copyWith(
              color: colorScheme.onErrorContainer,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }
}

/// Widget fallback ketika gambar preview gagal dimuat atau path kosong.
class _PreviewErrorFallback extends StatelessWidget {
  const _PreviewErrorFallback();

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    return Container(
      width: double.infinity,
      height: double.infinity,
      color: colorScheme.surfaceContainerHighest,
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.broken_image,
            size: 64,
            color: colorScheme.onSurfaceVariant,
          ),
          const SizedBox(height: 16),
          Text(
            'Gambar tidak tersedia',
            style: Theme.of(context).textTheme.titleMedium
                ?.copyWith(color: colorScheme.onSurfaceVariant),
          ),
        ],
      ),
    );
  }
}
