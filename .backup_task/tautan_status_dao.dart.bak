import 'package:sqflite/sqflite.dart';

import 'package:base_coc/core/util/parser_util.dart';
import 'package:base_coc/fitur/galeri_base/model/nama_tabel_tautan.dart';

/// Satu baris tabel `tautan_status`: status laporan "tautan rusak" per base.
class TautanStatus {
  const TautanStatus({
    required this.idBase,
    required this.jumlahLaporan,
    required this.diperbarui,
    this.terakhirDilaporkan,
  });

  /// Id base dari katalog (`BaseLayout.id`).
  final String idBase;

  /// Jumlah laporan "tautan rusak" tersimpan lokal.
  final int jumlahLaporan;

  /// Waktu laporan terakhir (waktu lokal, ISO 8601). `null` bila belum pernah dilaporkan.
  final String? terakhirDilaporkan;

  /// Waktu baris terakhir diperbarui/dibuat (waktu lokal, ISO 8601).
  final String diperbarui;

  /// Memetakan baris SQLite ke [TautanStatus].
  factory TautanStatus.fromSqflite(Map<String, Object?> row) {
    return TautanStatus(
      idBase: ParserUtil.parseStringOrNull(row[NamaKolomTautan.idBase]) ?? '',
      jumlahLaporan: ParserUtil.parseInt(
        row[NamaKolomTautan.jumlahLaporan],
        defaultValue: 0,
      ),
      terakhirDilaporkan: ParserUtil.parseStringOrNull(
        row[NamaKolomTautan.terakhirDilaporkan],
      ),
      diperbarui:
          ParserUtil.parseStringOrNull(row[NamaKolomTautan.diperbarui]) ?? '',
    );
  }
}

/// Data Access Object untuk tabel `tautan_status`.
class TautanStatusDao {
  TautanStatusDao(this._db);

  final Database _db;

  /// Mengambil seluruh baris, jumlah laporan terbanyak di atas.
  Future<List<TautanStatus>> ambilSemua() async {
    final rows = await _db.query(
      NamaTabelTautan.tautanStatus,
      orderBy: '${NamaKolomTautan.jumlahLaporan} DESC',
    );
    return rows.map(TautanStatus.fromSqflite).toList(growable: false);
  }

  /// Mencatat satu laporan "tautan rusak" untuk [idBase].
  ///
  /// Baris dibuat bila belum ada; bila sudah ada, `jumlah_laporan` dinaikkan
  /// satu dan `terakhir_dilaporkan`/`diperbarui` disetel ke waktu lokal.
  Future<void> lapor(String idBase) async {
    final now = DateTime.now().toIso8601String();
    await _db.transaction((txn) async {
      final existing = await txn.query(
        NamaTabelTautan.tautanStatus,
        where: '${NamaKolomTautan.idBase} = ?',
        whereArgs: [idBase],
        limit: 1,
      );
      if (existing.isEmpty) {
        await txn.insert(NamaTabelTautan.tautanStatus, <String, Object?>{
          NamaKolomTautan.idBase: idBase,
          NamaKolomTautan.jumlahLaporan: 1,
          NamaKolomTautan.terakhirDilaporkan: now,
          NamaKolomTautan.diperbarui: now,
        });
      } else {
        final jumlah = ParserUtil.parseInt(
          existing.first[NamaKolomTautan.jumlahLaporan],
          defaultValue: 0,
        );
        await txn.update(
          NamaTabelTautan.tautanStatus,
          <String, Object?>{
            NamaKolomTautan.jumlahLaporan: jumlah + 1,
            NamaKolomTautan.terakhirDilaporkan: now,
            NamaKolomTautan.diperbarui: now,
          },
          where: '${NamaKolomTautan.idBase} = ?',
          whereArgs: [idBase],
        );
      }
    });
  }

  /// Menandai [idBase] sudah ditinjau: menghapus baris laporan bila ada.
  ///
  /// Mengembalikan jumlah baris yang dihapus (`0` bila tidak ada baris).
  Future<int> tandaiDitinjau(String idBase) async {
    return _db.delete(
      NamaTabelTautan.tautanStatus,
      where: '${NamaKolomTautan.idBase} = ?',
      whereArgs: [idBase],
    );
  }

  /// Menghapus seluruh baris (digunakan pada pengujian).
  Future<void> hapusSemua() async {
    await _db.delete(NamaTabelTautan.tautanStatus);
  }
}
