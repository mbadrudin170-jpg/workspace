import 'package:flutter_riverpod/legacy.dart';

import 'package:base_coc/fitur/galeri_base/model/base_layout.dart';
import 'package:base_coc/fitur/galeri_base/model/filter_state.dart';

/// Notifier untuk state filter Town Hall, tipe base, dan tag strategi.
class FilterNotifier extends StateNotifier<FilterState> {
  FilterNotifier() : super(const FilterState());

  void setTownHall(TownHallLevel? value) {
    state = value == null
        ? state.copyWith(clearTownHall: true)
        : state.copyWith(townHall: value);
  }

  void setTipe(TipeBase? value) {
    state = value == null
        ? state.copyWith(clearTipe: true)
        : state.copyWith(tipe: value);
  }

  void setQuery(String value) {
    state = state.copyWith(query: value);
  }

  void toggleTag(TagStrategi tag) {
    final tags = {...state.tags};
    if (!tags.remove(tag)) {
      tags.add(tag);
    }
    state = state.copyWith(tags: tags);
  }

  void clearTags() {
    state = state.copyWith(clearTags: true);
  }

  void reset() {
    state = const FilterState();
  }
}

/// Provider state filter Town Hall, tipe base, dan tag strategi.
final filterProvider = StateNotifierProvider<FilterNotifier, FilterState>(
  (ref) => FilterNotifier(),
);
