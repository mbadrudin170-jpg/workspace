import 'package:flutter/foundation.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:base_coc/core/database/db_helper.dart';
import 'package:base_coc/core/database/favorit_dao.dart';

/// Provider [FavoritDao] yang dapat di-override pada unit/widget test.
final favoritDaoProvider = FutureProvider<FavoritDao>((ref) async {
  final db = await DbHelper().database;
  return FavoritDao(db);
});

/// Notifier untuk daftar id base favorit, terurut terbaru di atas.
///
/// Provider manual (bukan codegen) tidak di-autoDispose, sehingga state tetap
/// hidup selama aplikasi berjalan — setara `@Riverpod(keepAlive: true)`.
class FavoritNotifier extends AsyncNotifier<List<String>> {
  @override
  Future<List<String>> build() => _ambilSemua();

  Future<List<String>> _ambilSemua() async {
    final dao = await ref.read(favoritDaoProvider.future);
    return dao.ambilSemua();
  }

  /// Menandai [idBase] sebagai favorit bila belum ditandai, atau menghapusnya
  /// dari favorit bila sudah ditandai. State diperbarui setelah DB berhasil.
  Future<void> toggle(String idBase) async {
    try {
      final dataLama = await future;
      final dao = await ref.read(favoritDaoProvider.future);
      if (dataLama.contains(idBase)) {
        await dao.hapus(idBase);
        state = AsyncValue<List<String>>.data(
          dataLama.where((id) => id != idBase).toList(growable: false),
        );
      } else {
        await dao.tambah(idBase);
        state = AsyncValue<List<String>>.data(<String>[idBase, ...dataLama]);
      }
    } on Exception catch (e, s) {
      debugPrint('Gagal toggle favorit: idBase=$idBase, error=$e, stack=$s');
      rethrow;
    }
  }
}

/// Provider utama state favorit base (daftar `id_base`, terbaru di atas).
final favoritProvider = AsyncNotifierProvider<FavoritNotifier, List<String>>(
  FavoritNotifier.new,
);
