import 'package:flutter/material.dart';

import 'package:base_coc/fitur/upgrade_progress/model/item_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/model/progres_upgrade.dart';

/// Widget kartu ringkasan progres untuk satu kategori upgrade.
class RingkasanKategoriCard extends StatelessWidget {
  const RingkasanKategoriCard({
    super.key,
    required this.progresKategori,
    this.onTap,
  });

  final ProgresKategori progresKategori;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final colorScheme = theme.colorScheme;
    final persenLabel =
        '${(progresKategori.persentase * 100).toStringAsFixed(0)}%';

    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(12),
        child: Padding(
          padding: const EdgeInsets.all(12),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            spacing: 8,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Expanded(
                    child: Text(
                      progresKategori.kategori.label,
                      style: theme.textTheme.titleMedium?.copyWith(
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                  Text(
                    persenLabel,
                    style: theme.textTheme.titleMedium?.copyWith(
                      color: colorScheme.primary,
                      fontWeight: FontWeight.bold,
                      fontFeatures: const [FontFeature.tabularFigures()],
                    ),
                  ),
                ],
              ),
              ClipRRect(
                borderRadius: BorderRadius.circular(4),
                child: LinearProgressIndicator(
                  value: progresKategori.persentase,
                  minHeight: 8,
                  backgroundColor: colorScheme.surfaceContainerHighest,
                  color: colorScheme.primary,
                ),
              ),
              Text(
                '${progresKategori.jumlahSelesai} dari '
                '${progresKategori.jumlahTotal} item mencapai level target'
                '${progresKategori.totalSisaWaktu.inSeconds > 0 ? ' • Sisa waktu: ${_formatDurasi(progresKategori.totalSisaWaktu)}' : ''}',
                style: theme.textTheme.bodySmall?.copyWith(
                  color: colorScheme.onSurfaceVariant,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  String _formatDurasi(Duration durasi) {
    final hari = durasi.inDays;
    final jam = durasi.inHours % 24;
    final menit = durasi.inMinutes % 60;
    if (hari > 0) {
      return '${hari}h ${jam}j ${menit}m';
    }
    if (jam > 0) {
      return '${jam}j ${menit}m';
    }
    return '${menit}m';
  }
}

/// Widget daftar item detail upgrade untuk satu kategori.
class DaftarItemUpgrade extends StatelessWidget {
  const DaftarItemUpgrade({super.key, required this.items});

  final List<ItemUpgrade> items;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return ListView.separated(
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      itemCount: items.length,
      separatorBuilder: (context, index) => const Divider(height: 1),
      itemBuilder: (context, index) {
        final item = items[index];
        final isSelesai = item.sudahMaksimal;
        return ListTile(
          title: Text(item.nama),
          subtitle: Text(
            'Level ${item.levelSaatIni} / ${item.levelTarget}'
            '${item.sisaWaktu != null ? ' • Sisa: ${_formatDurasi(item.sisaWaktu!)}' : ''}'
            '${item.sisaSumberDaya != null ? ' • Sisa resource: ${item.sisaSumberDaya}' : ''}',
          ),
          trailing: isSelesai
              ? Icon(Icons.check_circle, color: theme.colorScheme.primary)
              : Text(
                  '${(item.persentaseLevel * 100).toStringAsFixed(0)}%',
                  style: theme.textTheme.labelMedium?.copyWith(
                    fontFeatures: const [FontFeature.tabularFigures()],
                  ),
                ),
        );
      },
    );
  }

  String _formatDurasi(Duration durasi) {
    final hari = durasi.inDays;
    final jam = durasi.inHours % 24;
    final menit = durasi.inMinutes % 60;
    if (hari > 0) {
      return '${hari}h ${jam}j ${menit}m';
    }
    if (jam > 0) {
      return '${jam}j ${menit}m';
    }
    return '${menit}m';
  }
}
