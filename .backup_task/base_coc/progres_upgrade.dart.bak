import 'package:base_coc/fitur/upgrade_progress/model/item_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/model/kategori_upgrade.dart';

/// Ringkasan progres satu kategori upgrade.
class ProgresKategori {
  const ProgresKategori({
    required this.kategori,
    required this.items,
    required this.jumlahSelesai,
  });

  final KategoriUpgrade kategori;
  final List<ItemUpgrade> items;
  final int jumlahSelesai;

  /// Total item pada kategori ini.
  int get jumlahTotal => items.length;

  /// Persentase penyelesaian item menuju level target (0.0–1.0).
  double get persentase {
    if (items.isEmpty) {
      return 0.0;
    }
    return (jumlahSelesai / items.length).clamp(0.0, 1.0);
  }

  /// Total sisa waktu upgrade yang sedang berjalan pada kategori ini.
  Duration get totalSisaWaktu {
    var totalDetik = 0;
    for (final item in items) {
      final detik = item.sisaWaktu?.inSeconds ?? 0;
      if (detik > 0) {
        totalDetik += detik;
      }
    }
    return Duration(seconds: totalDetik);
  }
}

/// Agregat progres upgrade desa untuk satu akun.
class ProgresUpgrade {
  const ProgresUpgrade({
    required this.perKategori,
    required this.itemsBerjalan,
  });

  /// Progres yang dikelompokkan per [KategoriUpgrade] sesuai urutan enum.
  final List<ProgresKategori> perKategori;

  /// Daftar item yang sedang memiliki sisa waktu upgrade (> 0).
  final List<ItemUpgrade> itemsBerjalan;

  /// Rata-rata progres gabungan seluruh kategori (0.0–1.0).
  double get persentaseTotal {
    if (perKategori.isEmpty) {
      return 0.0;
    }
    final total = perKategori.fold<double>(
      0.0,
      (sum, kategori) => sum + kategori.persentase,
    );
    return (total / perKategori.length).clamp(0.0, 1.0);
  }

  /// Total item yang sudah mencapai level target di seluruh kategori.
  int get jumlahItemSelesai =>
      perKategori.fold<int>(0, (sum, k) => sum + k.jumlahSelesai);

  /// Total seluruh item upgrade yang dilacak.
  int get jumlahItemTotal =>
      perKategori.fold<int>(0, (sum, k) => sum + k.jumlahTotal);
}
