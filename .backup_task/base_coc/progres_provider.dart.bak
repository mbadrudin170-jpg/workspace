import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_riverpod/legacy.dart';
import 'package:sqflite/sqflite.dart';

import 'package:base_coc/core/database/db_helper.dart';
import 'package:base_coc/core/database/progres_dao.dart';
import 'package:base_coc/fitur/upgrade_progress/model/akun_desa.dart';
import 'package:base_coc/fitur/upgrade_progress/model/impor_data_export_exception.dart';
import 'package:base_coc/fitur/upgrade_progress/model/item_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/model/progres_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/service/parser_data_export.dart';
import 'package:base_coc/fitur/upgrade_progress/service/progres_calculator.dart';

/// Provider singleton [DbHelper] untuk inisialisasi database SQLite.
final dbHelperProvider = Provider<DbHelper>((ref) {
  return DbHelper();
});

/// Provider database SQLite yang dapat di-override pada unit/widget test.
final databaseProvider = FutureProvider<Database>((ref) async {
  final dbHelper = ref.watch(dbHelperProvider);
  return dbHelper.database;
});

/// Provider factory [ProgresDao] yang dapat di-override pada unit/widget test.
final progresDaoProvider = FutureProvider<ProgresDao>((ref) async {
  final db = await ref.watch(databaseProvider.future);
  return ProgresDao(db);
});

/// State progres desa untuk satu akun aktif.
class ProgresDesaState {
  const ProgresDesaState({
    this.daftarAkun = const <AkunDesa>[],
    this.akunAktif,
    this.progres,
  });

  /// Seluruh akun desa yang tersimpan di database lokal.
  final List<AkunDesa> daftarAkun;

  /// Akun desa yang sedang ditampilkan.
  final AkunDesa? akunAktif;

  /// Hasil agregat progres upgrade untuk [akunAktif] (null bila belum dipilih).
  final ProgresUpgrade? progres;

  /// Membuat salinan state dengan nilai yang diperbarui.
  ProgresDesaState copyWith({
    List<AkunDesa>? daftarAkun,
    AkunDesa? akunAktif,
    ProgresUpgrade? progres,
  }) {
    return ProgresDesaState(
      daftarAkun: daftarAkun ?? this.daftarAkun,
      akunAktif: akunAktif ?? this.akunAktif,
      progres: progres ?? this.progres,
    );
  }
}

/// Notifier Riverpod untuk memuat daftar akun, memilih akun aktif,
/// mengimpor Data Export, mengganti nama akun, dan menghapus akun.
class ProgresNotifier extends StateNotifier<AsyncValue<ProgresDesaState>> {
  ProgresNotifier(this._ref, {ParserDataExport? parser})
    : _parser = parser ?? const ParserDataExport(),
      super(const AsyncValue<ProgresDesaState>.loading()) {
    _muat();
  }

  final Ref _ref;
  final ParserDataExport _parser;

  /// Memuat seluruh akun desa dan progres akun aktif dari database.
  Future<void> _muat() async {
    state = const AsyncValue<ProgresDesaState>.loading();
    try {
      final dao = await _ref.read(progresDaoProvider.future);
      final daftarAkun = await dao.ambilSemuaAkun();
      if (daftarAkun.isEmpty) {
        state = const AsyncValue<ProgresDesaState>.data(ProgresDesaState());
        return;
      }
      final akunAktif = daftarAkun.first;
      final items = await dao.ambilProgres(akunAktif.tagPemain);
      final progres = _hitungProgres(items);
      state = AsyncValue<ProgresDesaState>.data(
        ProgresDesaState(
          daftarAkun: daftarAkun,
          akunAktif: akunAktif,
          progres: progres,
        ),
      );
    } on ImporDataExportGagalException catch (e, st) {
      state = AsyncValue<ProgresDesaState>.error(e, st);
    } on Exception catch (e, st) {
      state = AsyncValue<ProgresDesaState>.error(e, st);
    }
  }

  /// Mengimpor teks Data Export baru atau memperbarui akun yang sudah ada.
  Future<void> imporDariExport(String teks) async {
    final hasil = _parser.parse(teks);
    final dao = await _ref.read(progresDaoProvider.future);
    final akun = AkunDesa(
      tagPemain: hasil.tagPemain,
      namaDesa: hasil.namaDesa,
      townHall: hasil.townHall,
      builderHall: hasil.builderHall,
      waktuImporTerakhir: DateTime.now(),
    );
    await dao.simpanProgres(akun: akun, items: hasil.items);
    await _muat();
  }

  /// Memuat ulang daftar akun dan progres dari database.
  Future<void> muatUlang() => _muat();

  /// Mengganti akun aktif berdasarkan [tagPemain].
  Future<void> pilihAkun(String tagPemain) async {
    final dao = await _ref.read(progresDaoProvider.future);
    final akun = await dao.ambilAkun(tagPemain);
    if (akun == null) {
      return;
    }
    final items = await dao.ambilProgres(tagPemain);
    final progres = _hitungProgres(items);
    final current = state.asData?.value;
    state = AsyncValue<ProgresDesaState>.data(
      current?.copyWith(akunAktif: akun, progres: progres) ??
          ProgresDesaState(
            daftarAkun: <AkunDesa>[akun],
            akunAktif: akun,
            progres: progres,
          ),
    );
  }

  /// Mengganti nama tampilan akun desa.
  Future<void> gantiNamaAkun({
    required String tagPemain,
    required String namaBaru,
  }) async {
    final dao = await _ref.read(progresDaoProvider.future);
    await dao.ubahNamaAkun(tagPemain: tagPemain, namaBaru: namaBaru);
    await _muat();
  }

  /// Menghapus akun desa beserta seluruh progres terkait.
  Future<void> hapusAkun(String tagPemain) async {
    final dao = await _ref.read(progresDaoProvider.future);
    await dao.hapusAkun(tagPemain);
    await _muat();
  }

  ProgresUpgrade _hitungProgres(List<ItemUpgrade> items) {
    final perKategori = hitungProgresPerKategori(items);
    final itemsBerjalan = items
        .where((item) => (item.sisaWaktu?.inSeconds ?? 0) > 0)
        .toList(growable: false);
    return ProgresUpgrade(
      perKategori: perKategori,
      itemsBerjalan: itemsBerjalan,
    );
  }
}

/// Provider utama state progres upgrade desa.
final progresProvider =
    StateNotifierProvider<ProgresNotifier, AsyncValue<ProgresDesaState>>((ref) {
      return ProgresNotifier(ref);
    });
