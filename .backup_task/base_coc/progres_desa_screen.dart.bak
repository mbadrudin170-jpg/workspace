import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:base_coc/fitur/upgrade_progress/model/akun_desa.dart';
import 'package:base_coc/fitur/upgrade_progress/model/item_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/model/progres_upgrade.dart';
import 'package:base_coc/fitur/upgrade_progress/provider/progres_provider.dart';
import 'package:base_coc/fitur/upgrade_progress/screen/impor_data_export_screen.dart';
import 'package:base_coc/fitur/upgrade_progress/widget/ringkasan_kategori.dart';

/// Layar ringkasan progres upgrade desa per kategori dan rincian item.
class ProgresDesaScreen extends ConsumerWidget {
  const ProgresDesaScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final stateAsync = ref.watch(progresProvider);
    final colorScheme = Theme.of(context).colorScheme;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Progres Desa'),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh),
            tooltip: 'Muat ulang',
            onPressed: () {
              unawaited(
                ref.read(progresProvider.notifier).muatUlang().catchError((
                  Object e,
                  StackTrace s,
                ) {
                  if (context.mounted) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text('Gagal memuat ulang: $e')),
                    );
                  }
                }),
              );
            },
          ),
        ],
      ),
      body: stateAsync.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (err, stack) => Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              spacing: 12,
              children: [
                Icon(Icons.error_outline, size: 48, color: colorScheme.error),
                Text(
                  'Gagal memuat data progres',
                  style: Theme.of(context).textTheme.titleMedium,
                ),
                Text(
                  '$err',
                  style: Theme.of(context).textTheme.bodySmall,
                  textAlign: TextAlign.center,
                ),
                FilledButton(
                  onPressed: () {
                    unawaited(
                      ref.read(progresProvider.notifier).muatUlang().catchError(
                        (Object e, StackTrace s) {
                          if (context.mounted) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              SnackBar(content: Text('Gagal memuat ulang: $e')),
                            );
                          }
                        },
                      ),
                    );
                  },
                  child: const Text('Coba lagi'),
                ),
              ],
            ),
          ),
        ),
        data: (state) {
          final akunAktif = state.akunAktif;
          final progres = state.progres;
          if (akunAktif == null || progres == null) {
            return _TampilanKosong(onImpor: () => _bukaImpor(context));
          }

          return RefreshIndicator(
            onRefresh: () => ref.read(progresProvider.notifier).muatUlang(),
            child: ListView(
              padding: const EdgeInsets.only(bottom: 16),
              children: [
                _HeaderAkun(
                  akun: akunAktif,
                  daftarAkun: state.daftarAkun,
                  progres: progres,
                  onPilihAkun: (tag) {
                    unawaited(
                      ref
                          .read(progresProvider.notifier)
                          .pilihAkun(tag)
                          .catchError((Object e, StackTrace s) {
                            if (context.mounted) {
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(
                                  content: Text('Gagal memilih akun: $e'),
                                ),
                              );
                            }
                          }),
                    );
                  },
                ),
                const SizedBox(height: 8),
                if (progres.itemsBerjalan.isNotEmpty) ...[
                  Padding(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 12,
                      vertical: 4,
                    ),
                    child: Text(
                      'Sedang Upgrade (${progres.itemsBerjalan.length} item)',
                      style: Theme.of(context).textTheme.titleSmall
                          ?.copyWith(fontWeight: FontWeight.bold),
                    ),
                  ),
                  for (final item in progres.itemsBerjalan)
                    Card(
                      margin: const EdgeInsets.symmetric(
                        horizontal: 12,
                        vertical: 4,
                      ),
                      child: ListTile(
                        leading: const Icon(Icons.construction),
                        title: Text(item.nama),
                        subtitle: Text(item.kategori.label),
                        trailing: Text(
                          _formatDurasi(item.sisaWaktu ?? Duration.zero),
                          style: Theme.of(context).textTheme.labelMedium
                              ?.copyWith(
                                color: Theme.of(context).colorScheme.primary,
                                fontWeight: FontWeight.bold,
                                fontFeatures: const [
                                  FontFeature.tabularFigures(),
                                ],
                              ),
                        ),
                      ),
                    ),
                  const SizedBox(height: 8),
                ],
                Padding(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 4,
                  ),
                  child: Text(
                    'Progres per Kategori',
                    style: Theme.of(context).textTheme.titleSmall
                        ?.copyWith(fontWeight: FontWeight.bold),
                  ),
                ),
                for (final kategori in progres.perKategori)
                  RingkasanKategoriCard(
                    progresKategori: kategori,
                    onTap: () => _tampilkanDetailKategori(
                      context,
                      kategori.kategori.label,
                      kategori.items,
                    ),
                  ),
              ],
            ),
          );
        },
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () => _bukaImpor(context),
        icon: const Icon(Icons.upload_file),
        label: const Text('Impor Data Export'),
      ),
    );
  }

  void _bukaImpor(BuildContext context) {
    unawaited(
      Navigator.of(context)
          .push(
            MaterialPageRoute<void>(
              builder: (_) => const ImporDataExportScreen(),
            ),
          )
          .catchError((Object e, StackTrace s) {
            if (context.mounted) {
              ScaffoldMessenger.of(context).showSnackBar(
                SnackBar(content: Text('Gagal membuka impor: $e')),
              );
            }
            return null;
          }),
    );
  }

  void _tampilkanDetailKategori(
    BuildContext context,
    String judul,
    List<ItemUpgrade> items,
  ) {
    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      builder: (context) {
        return DraggableScrollableSheet(
          expand: false,
          builder: (context, scrollController) {
            return Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Padding(
                  padding: const EdgeInsets.all(16),
                  child: Text(
                    'Detail $judul',
                    style: Theme.of(context).textTheme.titleMedium
                        ?.copyWith(fontWeight: FontWeight.bold),
                  ),
                ),
                Expanded(child: DaftarItemUpgrade(items: items)),
              ],
            );
          },
        );
      },
    );
  }

  String _formatDurasi(Duration durasi) {
    final hari = durasi.inDays;
    final jam = durasi.inHours % 24;
    final menit = durasi.inMinutes % 60;
    if (hari > 0) {
      return '${hari}h ${jam}j ${menit}m';
    }
    if (jam > 0) {
      return '${jam}j ${menit}m';
    }
    return '${menit}m';
  }
}

class _HeaderAkun extends StatelessWidget {
  const _HeaderAkun({
    required this.akun,
    required this.daftarAkun,
    required this.progres,
    required this.onPilihAkun,
  });

  final AkunDesa akun;
  final List<AkunDesa> daftarAkun;
  final ProgresUpgrade progres;
  final ValueChanged<String> onPilihAkun;

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    final persenTotal = (progres.persentaseTotal * 100).toStringAsFixed(0);

    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          spacing: 8,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        akun.namaDesa,
                        style: Theme.of(context).textTheme.titleMedium
                            ?.copyWith(fontWeight: FontWeight.bold),
                      ),
                      Text(
                        '${akun.tagPemain} • Town Hall ${akun.townHall}'
                        '${akun.builderHall != null ? ' • Builder Hall ${akun.builderHall}' : ''}',
                        style: Theme.of(context).textTheme.bodySmall
                            ?.copyWith(color: colorScheme.onSurfaceVariant),
                      ),
                    ],
                  ),
                ),
                if (daftarAkun.length > 1)
                  PopupMenuButton<String>(
                    icon: const Icon(Icons.swap_horiz),
                    tooltip: 'Ganti Akun',
                    onSelected: onPilihAkun,
                    itemBuilder: (context) {
                      return daftarAkun
                          .map(
                            (a) => PopupMenuItem<String>(
                              value: a.tagPemain,
                              child: Text('${a.namaDesa} (${a.tagPemain})'),
                            ),
                          )
                          .toList(growable: false);
                    },
                  ),
              ],
            ),
            ClipRRect(
              borderRadius: BorderRadius.circular(4),
              child: LinearProgressIndicator(
                value: progres.persentaseTotal,
                minHeight: 8,
                backgroundColor: colorScheme.surfaceContainerHighest,
                color: colorScheme.primary,
              ),
            ),
            Text(
              'Progres keseluruhan: $persenTotal% '
              '(${progres.jumlahItemSelesai} / ${progres.jumlahItemTotal} item)',
              style: Theme.of(context).textTheme.bodySmall,
            ),
          ],
        ),
      ),
    );
  }
}

class _TampilanKosong extends StatelessWidget {
  const _TampilanKosong({required this.onImpor});

  final VoidCallback onImpor;

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(24),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          spacing: 12,
          children: [
            Icon(
              Icons.bar_chart,
              size: 64,
              color: colorScheme.onSurfaceVariant,
            ),
            Text(
              'Belum ada data progres desa',
              style: Theme.of(context).textTheme.titleMedium
                  ?.copyWith(fontWeight: FontWeight.bold),
            ),
            Text(
              'Impor Data Export dari Clash of Clans untuk melihat '
              'progres upgrade desa Anda.',
              style: Theme.of(context).textTheme.bodyMedium
                  ?.copyWith(color: colorScheme.onSurfaceVariant),
              textAlign: TextAlign.center,
            ),
            const SizedBox(height: 8),
            FilledButton.icon(
              onPressed: onImpor,
              icon: const Icon(Icons.upload_file),
              label: const Text('Impor Data Export'),
            ),
          ],
        ),
      ),
    );
  }
}
